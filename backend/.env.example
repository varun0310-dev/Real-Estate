PORT=3001
MONGO_URI=mongodb://127.0.0.1:27017/real-estate
JWT_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:5173

# Super admin account created automatically on first backend start
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123

# Gmail (or SMTP) used for OTP, contact form, and subscription emails
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Google Sign-In (optional)
GOOGLE_CLIENT_ID=

# Razorpay TEST keys: Dashboard → Settings → API Keys → Test mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
